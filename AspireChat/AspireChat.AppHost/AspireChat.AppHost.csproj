<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>67437ad4-c794-44b2-a326-86edcd888c39</UserSecretsId>
        <!-- Keep NuGet-restored DCP/dashboard so CI and Aspire.Hosting.Testing keep working without a local Aspire CLI bundle. -->
        <AspireUseCliBundle>false</AspireUseCliBundle>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AspireChat.Api\AspireChat.Api.csproj" />
        <ProjectReference Include="..\AspireChat.Web\AspireChat.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Azure" Version="13.6.1" />
        <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.1" />
        <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="13.6.1" />
        <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.1" />
        <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.1" />
        <PackageReference Include="Azure.Storage.Blobs" Version="12.30.0" />
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
    </ItemGroup>

</Project>
